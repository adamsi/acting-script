# Clerk (Dashboard -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Supabase Postgres - use the "Transaction pooler" connection string (port 6543)
DB_URL=
INWORLD_API_KEY=
# Optional: comma-separated emails whose accounts may upload 30-page scripts (others: 10 pages)
# and may open the admin panel (/admin)
# EXTENDED_LIMIT_EMAILS=you@example.com
# Optional: a personal Inworld key for one account (its AI recordings are billed to this key)
# ADAM_API_KEY=
# ADAM_API_KEY_EMAIL=you@example.com
# Optional overrides
# INWORLD_MODEL=inworld-tts-2

# Character arc analysis (the only AI text feature). A Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: a fixed model. By default the newest stable "flash" model is used.
# GEMINI_MODEL=
